# TrendForge configuration (placeholders only - never commit real credentials).

# GitHub token for the official GitHub API; plain public read access is enough.
GITHUB_TOKEN=

# Optional: enables the LLM analysis pass. Without it, heuristics are used.
OPENAI_API_KEY=
